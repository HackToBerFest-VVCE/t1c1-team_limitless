# ScamLens AI — Public Frontend Environment Variables
# Copy this file to .env and replace placeholders with your actual Supabase credentials.

# Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Your Supabase public anonymous / publishable key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: GEMMA_API_KEY must NEVER be placed in this frontend .env file!
# Store GEMMA_API_KEY securely inside Supabase Edge Function secrets using:
# supabase secrets set GEMMA_API_KEY="your-key-here"
